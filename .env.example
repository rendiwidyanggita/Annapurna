# ==============================================================================
# ANNAPURNA Adventure — Environment Variables Template
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# Connection pooling URL (digunakan untuk Prisma Client di runtime serverless)
NEXT_PUBLIC_SUPABASE_URL="https://..."

# Direct URL (digunakan untuk Prisma Migrate & CLI)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable..."

# ------------------------------------------------------------------------------
# 2. Supabase Auth & Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. Midtrans Payment Gateway
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-..."
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. OpenRouter AI (Chatbot Customer)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
OPENROUTER_MODELS="nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free"

# ------------------------------------------------------------------------------
# 5. Upstash Redis (Rate Limiting — AA-118)
# ------------------------------------------------------------------------------
# Buat database di https://console.upstash.com/ → pilih region Asia (Singapore)
# Salin REST URL dan REST Token dari dashboard Upstash
UPSTASH_REDIS_REST_URL="https://[DATABASE-NAME].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
